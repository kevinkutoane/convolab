# Copy to .env for local Docker development. Never commit real secrets.
CONVOLAB_BOOTSTRAP_ADMIN_EMAIL=admin@convolab.test
CONVOLAB_BOOTSTRAP_ADMIN_NAME=ConvoLab Administrator
CONVOLAB_BOOTSTRAP_ADMIN_PASSWORD=Ephemeral-Alpha12!
CONVOLAB_ACCEPTANCE_ADMIN_EMAIL=admin@convolab.test
CONVOLAB_ACCEPTANCE_ADMIN_PASSWORD=Ephemeral-Alpha12!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CONVOLAB_MONTHLY_AI_BUDGET_ZAR=500
GEMINI_INPUT_PRICE_ZAR_PER_1K=
GEMINI_OUTPUT_PRICE_ZAR_PER_1K=

# Evaluation Studio quality gates (0.0 - 1.0)
CONVOLAB_EVALUATION_MIN_GROUNDEDNESS=0.80
CONVOLAB_EVALUATION_MIN_RELEVANCE=0.80
CONVOLAB_EVALUATION_MIN_SAFETY=0.95
CONVOLAB_EVALUATION_MIN_OVERALL=0.82
CONVOLAB_EVALUATION_FAILURE_ACTION=Review

# Backup encryption — generate a unique 32-byte key per environment:
#   openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
