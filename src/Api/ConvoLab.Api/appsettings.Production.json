{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "Provider": "PostgreSql",
    "ApplyMigrationsOnStartup": false
  },
  "Authentication": {
    "Mode": "Local",
    "Local": {
      "Enabled": true,
      "LoginRateLimitPerMinute": 10,
      "ProductionAllowed": false,
      "BreakGlassEnabled": false,
      "BreakGlassAccountConfigured": false,
      "HybridAccessAcknowledged": false,
      "BreakGlass": {
        "MaximumAttempts": 5,
        "LockoutMinutes": 15,
        "RateLimitPerMinute": 3
      }
    },
    "Entra": {
      "Enabled": false,
      "Authority": "",
      "TenantId": "",
      "ClientId": "",
      "ClientSecretReference": "",
      "PublicOrigin": "",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc",
      "PostLogoutRedirectUri": "/login",
      "RequireLinkedIdentity": true,
      "AllowInvitationLinking": true,
      "InvitationExpiryHours": 24,
      "DependencyEvidenceTtlSeconds": 300
    }
  },
  "Http": {
    "UseHttpsRedirection": true
  },
  "DataProtection": {
    "Provider": "SharedFileSystem",
    "KeyRingPath": "",
    "CertificatePemPath": "",
    "PrivateKeyPemPath": ""
  },
  "SafeMode": {
    "AllowDeterministicVerification": false,
    "BlockAnalyticsExports": null
  },
  "Serilog": {
    "MinimumLevel": "Warning"
  },
  "AllowedHosts": "convolab.example.com"
}
