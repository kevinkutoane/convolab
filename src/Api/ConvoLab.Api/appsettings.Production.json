{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "Provider": "PostgreSql",
    "ApplyMigrationsOnStartup": false
  },
  "Authentication": {
    "Mode": "Local",
    "Local": {
      "ProductionAllowed": false
    }
  },
  "Http": {
    "UseHttpsRedirection": true
  },
  "DataProtection": {
    "Provider": "SharedFileSystem",
    "KeyRingPath": "",
    "CertificatePemPath": "",
    "PrivateKeyPemPath": ""
  },
  "SafeMode": {
    "AllowDeterministicVerification": false,
    "BlockAnalyticsExports": null
  },
  "Serilog": {
    "MinimumLevel": "Warning"
  },
  "AllowedHosts": ""
}
